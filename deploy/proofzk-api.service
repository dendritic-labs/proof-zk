[Unit]
Description=ProofZK API Server
After=network.target

[Service]
Type=simple
User=proofzk
Group=proofzk
WorkingDirectory=/opt/proofzk/api
ExecStart=/opt/proofzk/api/target/release/proofzk-api
Restart=always
RestartSec=10
Environment=PORT=8080
Environment=RUST_LOG=info

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/proofzk/api

[Install]
WantedBy=multi-user.target